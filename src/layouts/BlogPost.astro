---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/manrope';
const { frontmatter } = Astro.props;
const basePath = `${import.meta.env.BASE_URL}/`.replace(/\/{2,}/g, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={frontmatter.description} />
    <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
    <title>{frontmatter.title}</title>
  </head>
  <body>
    <main>
      <a class="back" href={basePath}>← Trask</a>
      <article>
        <header>
          <h1>{frontmatter.title}</h1>
          <p class="description">{frontmatter.description}</p>
          <p class="meta">{frontmatter.author} · {frontmatter.date}</p>
        </header>
        <slot />
      </article>
    </main>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  html { font-family: "Source Serif 4 Variable", Georgia, serif; color: #242424; background: #fff; }
  body { margin: 0; font-size: 17px; line-height: 1.58; }
  main { width: min(660px, calc(100% - 40px)); margin: 0 auto; padding: 42px 0 72px; }
  article > header { margin: 38px 0 44px; }
  .back { color: #707070; font: 500 13px/1.4 "Manrope Variable", sans-serif; text-decoration: none; }
  .back:hover { color: #111; }
  h1, h2, h3 { color: #171717; font-family: "Manrope Variable", sans-serif; line-height: 1.2; }
  h1 { margin: 0; font-size: clamp(2.1rem, 7vw, 3.25rem); font-weight: 650; letter-spacing: -0.045em; }
  h2 { margin: 38px 0 11px; font-size: 1.5rem; font-weight: 650; letter-spacing: -0.025em; }
  h3 { margin: 28px 0 9px; font-size: 1.15rem; font-weight: 650; }
  p { margin: 0 0 17px; }
  .description { margin: 17px 0 12px; color: #555; font-size: 1.16rem; line-height: 1.48; }
  .meta { color: #777; font: 500 12px/1.4 "Manrope Variable", sans-serif; }
  a { color: #1457c7; text-underline-offset: 3px; }
  a:hover { color: #0b3680; }
  strong { color: #111; }
  blockquote { margin: 26px 0; padding-left: 18px; border-left: 2px solid #d5d5d5; color: #555; }
  blockquote p { margin: 0; }
  img, video { display: block; max-width: 100%; height: auto; margin: 24px 0 8px; }
  hr { margin: 38px 0; border: 0; border-top: 1px solid #ddd; }
  code { padding: 2px 5px; border-radius: 4px; background: #f3f3f3; font: .9em ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  pre { overflow-x: auto; margin: 22px 0; padding: 16px 18px; border: 1px solid #e2e2e2; background: #f7f7f7; line-height: 1.5; }
  pre code { padding: 0; background: transparent; }
  ul, ol { margin: 0 0 19px; padding-left: 26px; }
  li { margin: 5px 0; }
  table { width: 100%; margin: 28px 0; border-collapse: collapse; font-size: 15px; }
  th, td { padding: 10px 12px; border-bottom: 1px solid #ddd; text-align: left; }
  a:focus-visible { outline: 2px solid #1457c7; outline-offset: 3px; }
  @media (max-width: 600px) {
    main { padding-top: 26px; }
    article > header { margin: 30px 0 38px; }
    body { font-size: 16px; }
    table { display: block; overflow-x: auto; }
  }
</style>
